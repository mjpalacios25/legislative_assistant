# Copy to .env.local and fill in.

# Where the FastAPI backend lives. Server-only (read in next.config.ts by the
# /api/* rewrite) so it is never inlined into the client bundle.
BACKEND_URL=http://localhost:8000

# Base URL the browser prefixes onto API calls. Leave empty to use the current
# origin, which routes through the rewrite above.
NEXT_PUBLIC_API_URL=

# Set to "in-memory" to serve chat from the local mock stream instead of the
# backend. Useful for frontend work, since the real backend loads a 9B model
# and connects to Neo4j at import time. Leave unset to use the real backend.
NEXT_PUBLIC_ADAPTER_TYPE=
